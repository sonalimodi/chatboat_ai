APP_NAME="AI Chatbot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatbot_ai
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# LLM provider fallback order - tried strictly left to right
LLM_PROVIDERS=gemini,groq,openrouter
LLM_TIMEOUT=60
LLM_MAX_HISTORY_MESSAGES=20

# Primary - Google Gemini (https://aistudio.google.com/apikey)
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta

# Fallback #1 - Groq, free tier (https://console.groq.com/keys)
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_URL=https://api.groq.com/openai/v1

# Fallback #2 - OpenRouter, free tier (https://openrouter.ai/keys)
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_URL=https://openrouter.ai/api/v1

# File attachments (PDF/TXT) - text is extracted at upload time and
# replayed into LLM requests as extra context for that message's turn
ATTACHMENT_MAX_SIZE_KB=5120
ATTACHMENT_MAX_EXTRACT_CHARS=15000
ATTACHMENT_DISK=local
